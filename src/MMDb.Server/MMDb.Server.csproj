<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- A library: the PC app hosts it in-process (see PhoneHost). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" />
    <!-- Smaller copies of the covers for phones. Here rather than in Infrastructure, which the phone app also uses. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMDb.Application\MMDb.Application.csproj" />
    <ProjectReference Include="..\MMDb.Infrastructure\MMDb.Infrastructure.csproj" />
    <ProjectReference Include="..\MMDb.Contracts\MMDb.Contracts.csproj" />
    <ProjectReference Include="..\MMDb.Local\MMDb.Local.csproj" />
  </ItemGroup>

</Project>
