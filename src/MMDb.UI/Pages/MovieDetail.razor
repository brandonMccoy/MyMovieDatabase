@page "/movies/{Id:guid}"
@inject ICollectionApi Api
@inject NavigationManager Navigation
@inject ShelfCounts Counts
@inject IServiceProvider Services
@inject ShelfDevice Device

<PageTitle>@(_movie?.Title ?? "Movie") · Shelf</PageTitle>

<div class="topbar">
    <a class="btn ghost back" href=""><Icon Name="back" />Movies</a>
    @if (!Device.IsPhone)
    {
        <SearchBox />
    }
</div>

@if (_loaded && _movie is null)
{
    <div class="content">
        <div class="empty">
            <h1>Movie not found</h1>
            <p>It isn't in your collection any more.</p>
            <a class="btn" href="">Back to movies</a>
        </div>
    </div>
}
else if (_movie is not null)
{
    <div class="hero"><div class="backdrop" style="@PosterColors.Style(_movie.Title)"></div></div>
    <div class="detail">
        <div>
            <Poster Title="@_movie.Title" Subtitle="@Directors(" & ")" ImageUrl="_movie.CoverUrl" />
        </div>

        <div>
            <div class="fmts">
                @foreach (var format in _movie.Formats)
                {
                    <FormatBadge Format="format.Format" />
                }
            </div>
            <h1 class="title-lg">@_movie.Title@if (_movie.Year is { } year) {<span class="yr">@year</span>}</h1>
            @if (_movie.Directors.Count > 0)
            {
                <div class="byline">Directed by @for (var i = 0; i < _movie.Directors.Count; i++)
                    {
                        @Separator(i, _movie.Directors.Count)<b>@_movie.Directors[i]</b>
                    }</div>
            }
            <div class="meta-row">
                @if (_movie.Rating is not null)
                {
                    <span class="rating">@_movie.Rating</span>
                }
                @foreach (var (part, index) in MetaParts().Select((p, i) => (p, i)))
                {
                    @if (index > 0)
                    {
                        <span class="sep"></span>
                    }
                    <span>@part</span>
                }
            </div>
            <div class="actions">
                <a class="btn primary" href="@_movie.TrailerUrl.AbsoluteUri" target="_blank" rel="noopener"><Icon Name="play" />Watch trailer</a>
                @if (!Device.IsPhone)
                {
                <a class="btn" href="movies/@_movie.Id/edit"><Icon Name="edit" />Edit</a>
                <div class="menu-wrap">
                    <button type="button" class="btn ghost" aria-label="More" aria-expanded="@Aria.Bool(_menuOpen)" @onclick="() => _menuOpen = !_menuOpen"><Icon Name="dots" /></button>
                    @if (_menuOpen)
                    {
                        <div class="menu" role="menu">
                            <button type="button" role="menuitem" class="danger" @onclick="AskToDelete">Delete movie…</button>
                        </div>
                    }
                </div>
                }
            </div>

            @if (_confirmingDelete)
            {
                <div class="confirm" role="alertdialog" aria-label="Delete movie">
                    <div><b>Delete @_movie.Title?</b> This removes the film and every format you own it on.</div>
                    <div class="confirm-actions">
                        <button type="button" class="btn" @onclick="() => _confirmingDelete = false">Cancel</button>
                        <button type="button" class="btn danger" @onclick="DeleteAsync">Delete</button>
                    </div>
                </div>
            }

            @if (_movie.Overview is not null)
            {
                <p class="synopsis">@_movie.Overview</p>
            }

            <div class="tabs" role="tablist">
                @foreach (var tab in Enum.GetValues<Tab>())
                {
                    <button type="button" role="tab" class="@(_tab == tab ? "on" : "")" aria-selected="@Aria.Bool(_tab == tab)" @onclick="() => _tab = tab">@tab</button>
                }
            </div>
            @switch (_tab)
            {
                case Tab.Cast:
                    <CastList Cast="_movie.Cast" />
                    break;
                case Tab.Crew:
                    <CrewList Directors="_movie.Directors" Crew="_movie.Crew" />
                    break;
                case Tab.Details:
                    <dl class="kv">
                        <dt>Added</dt><dd>@LongDate(_movie.CreatedAt)</dd>
                        <dt>Last edited</dt><dd>@LongDate(_movie.UpdatedAt)</dd>
                        @if (_movie.TmdbId is { } tmdb)
                        {
                            <dt>TMDB</dt><dd class="mono">@tmdb</dd>
                        }
                    </dl>
                    break;
            }
        </div>

        <div>
            <div class="panel">
                <h3>Formats owned @if (!Device.IsPhone) {<a href="movies/@_movie.Id/edit">+ Add format</a>}</h3>
                @foreach (var format in _movie.Formats)
                {
                    var file = format.Format == MovieFormatKind.Digital && _digital is not null ? format.FilePath : null;
                    <div class="owned">
                        <FormatBadge Format="format.Format" />
                        <span class="small">Added @MonthYear(format.AddedAt)</span>
                    </div>
                    @if (format.Upc is not null)
                    {
                        <div class="mono owned-code">UPC @format.Upc</div>
                    }
                    @if (format.FilePath is not null)
                    {
                        <div class="mono owned-code">@format.FilePath</div>
                        @if (file is not null && !_fileThere)
                        {
                            <div class="warn file-problem">File not found</div>
                        }
                        else if (file is not null)
                        {
                            <button type="button" class="btn sm play" @onclick="PlayAsync"><Icon Name="play" />Play file</button>
                            @if (_playFailed)
                            {
                                <div class="warn file-problem">Couldn't open the file. Check that this PC has a player for it.</div>
                            }
                        }
                    }
                }
            </div>
            @if (_note is not null)
            {
                <div class="panel">
                    <a class="vault" href="@_note.OpenUri.OriginalString" target="_blank" rel="noopener" title="Open in Obsidian">
                        <Icon Name="obsidian" /><span>@_note.Path</span>
                    </a>
                </div>
            }
        </div>
    </div>
}

@code {
    private MovieDto? _movie;
    private VaultNoteDto? _note;
    private IDigitalApi? _digital;
    private bool _fileThere;
    private bool _playFailed;
    private bool _loaded;
    private bool _menuOpen;
    private bool _confirmingDelete;
    private Tab _tab = Tab.Cast;

    private enum Tab
    {
        Cast,
        Crew,
        Details,
    }

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _movie = await Api.GetMovieAsync(Id);
        _note = _movie is null ? null : Services.GetService<IVaultApi>()?.NoteFor(Id);

        // The PC plays a digital copy's file; the phone has no way to the file.
        _digital = Services.GetService<IDigitalApi>();
        _playFailed = false;
        CheckFile();
        _loaded = true;
    }

    private void CheckFile() =>
        _fileThere = _digital is not null
            && _movie?.Formats.FirstOrDefault(f => f.Format == MovieFormatKind.Digital)?.FilePath is { } path
            && _digital.FileExists(path);

    private async Task PlayAsync()
    {
        _playFailed = !await _digital!.PlayAsync(Id);
        CheckFile();
    }

    private void AskToDelete()
    {
        _menuOpen = false;
        _confirmingDelete = true;
    }

    private async Task DeleteAsync()
    {
        await Api.DeleteMovieAsync(Id);
        await Counts.RefreshAsync();
        Navigation.NavigateTo("");
    }

    private IEnumerable<string> MetaParts()
    {
        if (_movie!.RuntimeMinutes is { } minutes)
        {
            yield return $"{minutes} min";
        }

        foreach (var genre in _movie.Genres)
        {
            yield return genre;
        }
    }

    private string Directors(string separator) => string.Join(separator, _movie!.Directors);

    // "A", "A & B", "A, B & C"
    private static string Separator(int index, int count) => index == 0 ? "" : index == count - 1 ? " & " : ", ";

    private static string MonthYear(DateTimeOffset at) => at.ToLocalTime().ToString("MMM yyyy", CultureInfo.InvariantCulture);

    private static string LongDate(DateTimeOffset at) => at.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);
}
