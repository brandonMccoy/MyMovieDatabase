@page "/phone"
@implements IDisposable
@using MMDb.Contracts.Phone
@using MMDb.UI.Phone
@inject IServiceProvider Services
@inject TimeProvider Clock
@inject ITypesApi Types

<PageTitle>This phone · Shelf</PageTitle>

@* Phone only: which PC this phone is paired with, how fresh its copy of the collection is, and forgetting the PC. *@
<div class="topbar">
    <a class="btn ghost back" href="@TypeRoutes.Home(Types.InUse)"><Icon Name="back" />@TypeRoutes.HomeName(Types.InUse)</a>
</div>
<div class="content">
    <div class="section-head"><h1>This phone</h1></div>
    @if (_link is not null)
    {
        <section class="set" aria-labelledby="pc-heading">
            <h3 id="pc-heading">Paired with @(_link.PcName ?? "your PC")</h3>
            <div class="desc">@(_link.State == PcLinkState.Connected ? "Connected" : "Not reachable right now")@if (_link.Address is not null) {<span> · <span class="mono">@_link.Address</span></span>}</div>
            @if (_confirming)
            {
                <div class="confirm" role="alertdialog" aria-label="Forget this PC">
                    <div><b>Forget @(_link.PcName ?? "this PC")?</b> To use Shelf on this phone again you'll pair it with the code on the PC.</div>
                    <div class="confirm-actions">
                        <button type="button" class="btn" @onclick="() => _confirming = false">Cancel</button>
                        <button type="button" class="btn danger" @onclick="() => _link.ForgetAsync()">Forget</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="btn sm" @onclick="() => _confirming = true">Forget this PC…</button>
            }
        </section>
    }
    @if (_sync is not null && _link is not null and not { State: PcLinkState.NotPaired })
    {
        var status = _sync.Status;
        <section class="set" aria-labelledby="copy-heading">
            <h3 id="copy-heading">Your collection on this phone</h3>
            <div class="desc">
                @if (status.SyncedAt is { } at)
                {
                    <span>As of @CopyAge.When(at, Clock)</span>
                }
                else
                {
                    <span>Not copied yet</span>
                }
                @if (status.Waiting > 0)
                {
                    <span> · @CopyAge.Changes(status.Waiting) to send</span>
                }
            </div>
            <button type="button" class="btn sm" disabled="@(_syncing || status.State == PhoneSyncState.Syncing)" @onclick="SyncAsync">
                @(_syncing || status.State == PhoneSyncState.Syncing ? "Syncing…" : "Sync now")
            </button>
        </section>
    }
</div>

@code {
    private IPcLink? _link;
    private IPhoneSync? _sync;
    private bool _confirming;
    private bool _syncing;

    protected override void OnInitialized()
    {
        _link = Services.GetService<IPcLink>();
        _sync = Services.GetService<IPhoneSync>();
        if (_link is not null)
        {
            _link.Changed += OnChanged;
        }

        if (_sync is not null)
        {
            _sync.Changed += OnChanged;
        }
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        try
        {
            await _sync!.SyncAsync();
        }
        finally
        {
            _syncing = false;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_link is not null)
        {
            _link.Changed -= OnChanged;
        }

        if (_sync is not null)
        {
            _sync.Changed -= OnChanged;
        }
    }
}
