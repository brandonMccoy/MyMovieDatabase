@page "/"
@page "/movies"
@implements IDisposable
@using MMDb.UI.Movies
@inject ICollectionApi Api
@inject NavigationManager Navigation
@inject ShelfDevice Device

<PageTitle>Movies · Shelf</PageTitle>

@if (Device.IsPhone)
{
    @* As mocked for the phone: title, "Do I own…?" search, filters, covers. Adding is done by scanning. *@
    <div class="appbar"><h1 class="ttl">Movies</h1><a class="right" href="phone" aria-label="This phone"><Icon Name="dots" /></a></div>
    <MMDb.UI.Phone.AwayLine />
    <div class="topbar">
        <SearchBox Value="@Q" ValueChanged="Search" Placeholder="Do I own…?" />
    </div>
}
else
{
    <div class="topbar">
        <SearchBox Value="@Q" ValueChanged="Search" />
        <div class="spacer"></div>
        <a class="btn primary" href="movies/new"><Icon Name="plus" />Add movie</a>
    </div>
}

@if (Device.IsPhone && !string.IsNullOrWhiteSpace(Q))
{
    <MMDb.UI.Phone.OwnSearch Query="@Q" Kind="MMDb.Contracts.Scans.ProductKind.Movie" />
}
else
{
<div class="content">
    @if (!Device.IsPhone)
    {
        <div class="section-head">
            <h1>Movies</h1>
            @if (_list is not null)
            {
                <span class="sub">@Plural(_list.Facets.FilmCount, "film") · @Plural(_list.Facets.DiscCount, "disc")</span>
            }
        </div>
    }

    @if (_list is null)
    {
        @* Loading: in-process this is a blink, so no spinner. *@
    }
    else if (_list.Facets.FilmCount == 0)
    {
        <div class="empty">
            <h2>Your shelf is empty</h2>
            @if (Device.IsPhone)
            {
                <p>Scan the barcode of the first movie you own.</p>
                <a class="btn primary" href="scan"><Icon Name="scan" />Scan</a>
            }
            else
            {
                <p>Add the first movie you own. You can fill in as much or as little as you like.</p>
                <a class="btn primary" href="movies/new"><Icon Name="plus" />Add movie</a>
            }
        </div>
    }
    else
    {
        @* The button opens the panel; what it applied shows beside it, a chip each. On the phone they go onto a
           second line rather than off the screen. *@
        <div class="filters @(Device.IsPhone ? "wrap" : null)">
            <div class="menu-wrap">
                <button type="button" class="chip open-filters" aria-haspopup="dialog" aria-expanded="@Aria.Bool(_filtering)" @onclick="() => _filtering = true"><Icon Name="filter" />Filter</button>
                @if (_filtering)
                {
                    <MovieFilterPanel Facets="_list.Facets" Chosen="_chosen" OnApply="Apply" OnClear="Clear" OnClose="() => _filtering = false" />
                }
            </div>
            @foreach (var format in _chosen.Formats)
            {
                <a class="chip on picked" @key="format" href="@Without("format", _chosen.Formats, format)" aria-label="@Formats.Name(format): clear">@Formats.Name(format)<Icon Name="x" /></a>
            }
            @foreach (var genre in _chosen.Genres)
            {
                <a class="chip on picked" @key="genre" href="@Without("genre", _chosen.Genres, genre)" aria-label="@genre: clear">@genre<Icon Name="x" /></a>
            }
            @foreach (var decade in _chosen.Decades)
            {
                <a class="chip on picked" @key="decade" href="@Without("decade", _chosen.Decades, decade)" aria-label="@(decade)s: clear">@(decade)s<Icon Name="x" /></a>
            }
            @PersonChips
            @if (!Device.IsPhone)
            {
                <div class="spacer"></div>
                <label class="select">Sort
                    <select value="@SelectedSort" @onchange='e => SetQuery("sort", e.Value as string == nameof(MovieSortOrder.RecentlyAdded) ? null : e.Value as string)'>
                        <option value="@MovieSortOrder.RecentlyAdded">Recently added</option>
                        <option value="@MovieSortOrder.Title">Title</option>
                        <option value="@MovieSortOrder.Year">Year</option>
                    </select>
                </label>
            }
        </div>

        @if (_list.Movies.Count == 0)
        {
            <div class="empty">
                <h2>No films match</h2>
                <p>Nothing in your collection matches this search and these filters.</p>
                <a class="btn" href="">Clear search and filters</a>
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var movie in _list.Movies)
                {
                    <div class="card" @key="movie.Id">
                        <div class="cover">
                            <a href="movies/@movie.Id" aria-label="@movie.Title">
                                <Poster Title="@movie.Title" Subtitle="@string.Join(" & ", movie.Directors)" ImageUrl="movie.CoverUrl" />
                            </a>
                        </div>
                        <a class="t" href="movies/@movie.Id">@movie.Title</a>
                        <div class="m">
                            @movie.Year
                            @foreach (var format in movie.Formats)
                            {
                                <FormatBadge Format="format" Short />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
}

@code {
    private MovieListResponse? _list;
    private CancellationTokenSource? _loading;
    private MovieFilterChoice _chosen = MovieFilterChoice.None;
    private bool _filtering;

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    // Each of these can be in the address more than once: the panel ticks several.
    [SupplyParameterFromQuery(Name = "format")] public string[]? Format { get; set; }

    [SupplyParameterFromQuery(Name = "genre")] public string[]? Genre { get; set; }

    [SupplyParameterFromQuery(Name = "decade")] public int[]? Decade { get; set; }

    [SupplyParameterFromQuery(Name = "director")] public string? Director { get; set; }

    [SupplyParameterFromQuery(Name = "actor")] public string? Actor { get; set; }

    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    // Set by a bar on the Stats screen; the chip takes it off again.
    private RenderFragment PersonChips => @<text>
        @if (!string.IsNullOrWhiteSpace(Director))
        {
            <a class="chip on picked director" href="@Navigation.GetUriWithQueryParameter("director", (string?)null)" aria-label="Directed by @Director: clear">Directed by @Director<Icon Name="x" /></a>
        }
        @if (!string.IsNullOrWhiteSpace(Actor))
        {
            <a class="chip on picked actor" href="@Navigation.GetUriWithQueryParameter("actor", (string?)null)" aria-label="With @Actor: clear">With @Actor<Icon Name="x" /></a>
        }
    </text>;

    private MovieSortOrder SelectedSort => Enum.TryParse<MovieSortOrder>(Sort, ignoreCase: true, out var s) && Enum.IsDefined(s) ? s : MovieSortOrder.RecentlyAdded;

    protected override void OnInitialized() => Api.Changed += OnCollectionChanged;

    // Something was saved elsewhere (a phone, another screen): show it.
    private void OnCollectionChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    protected override Task OnParametersSetAsync()
    {
        _chosen = new(
            [.. (Format ?? []).Select(FormatOf).OfType<MovieFormatKind>().Distinct()],
            [.. (Genre ?? []).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct(StringComparer.OrdinalIgnoreCase)],
            [.. (Decade ?? []).Distinct()]);
        return LoadAsync();
    }

    private static MovieFormatKind? FormatOf(string text) =>
        Enum.TryParse<MovieFormatKind>(text, ignoreCase: true, out var format) && Enum.IsDefined(format) ? format : null;

    private async Task LoadAsync()
    {
        // Typing fires a load per keystroke; only the newest one may update the page.
        _loading?.Cancel();
        _loading?.Dispose();
        _loading = new CancellationTokenSource();
        var token = _loading.Token;

        var request = new MovieListRequest { Search = Q, Formats = _chosen.Formats, Genres = _chosen.Genres, Decades = _chosen.Decades, Director = Director, Actor = Actor, Sort = SelectedSort };
        try
        {
            var list = await Api.ListMoviesAsync(request, token);
            if (!token.IsCancellationRequested)
            {
                _list = list;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private void Search(string text) => SetQuery("q", text, replace: true);

    private void SetQuery(string name, string? value, bool replace = false) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(name, string.IsNullOrWhiteSpace(value) ? null : value), replace: replace);

    private void Apply(MovieFilterChoice choice)
    {
        _filtering = false;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["format"] = Values(choice.Formats),
            ["genre"] = Values(choice.Genres),
            ["decade"] = Values(choice.Decades),
        }));
    }

    // Everything in the filter row comes off, the director or actor a Stats bar set as well.
    private void Clear()
    {
        _filtering = false;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["format"] = null, ["genre"] = null, ["decade"] = null, ["director"] = null, ["actor"] = null,
        }));
    }

    /// <summary>This address with one value of a filter taken off.</summary>
    private string Without<T>(string name, IReadOnlyList<T> chosen, T value) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [name] = Values(chosen.Where(v => !Equals(v, value))) });

    private static string[]? Values<T>(IEnumerable<T> values)
    {
        string[] texts = [.. values.Select(v => Convert.ToString(v, CultureInfo.InvariantCulture)!)];
        return texts.Length == 0 ? null : texts;
    }

    private static string Count(int n) => n.ToString("N0", CultureInfo.InvariantCulture);

    private static string Plural(int n, string noun) => $"{Count(n)} {noun}{(n == 1 ? "" : "s")}";

    public void Dispose()
    {
        Api.Changed -= OnCollectionChanged;
        _loading?.Cancel();
        _loading?.Dispose();
    }
}
