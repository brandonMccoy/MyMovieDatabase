@page "/settings"
@implements IDisposable
@inject IServiceProvider Services

<PageTitle>Settings · Shelf</PageTitle>

<div class="topbar">
    <SearchBox />
</div>

<div class="content">
    <div class="section-head"><h1>Settings</h1></div>
    <div class="settings">
        @if (Services.GetService<IPhoneApi>() is not null)
        {
            <MMDb.UI.Phone.PhoneSettings />
        }
        @if (_vault is not null)
        {
            var status = _vault.Status;
            var on = status.State != VaultSyncState.Off;
            <section class="set" aria-labelledby="vault-heading">
                <h3 id="vault-heading">Obsidian vault</h3>
                <div class="desc">Shelf writes one note per film here. It only edits notes it created.</div>
                <div class="setrow">
                    <span class="lbl">Use a vault</span>
                    <span class="small">Turning it off leaves the notes already written where they are</span>
                    <button type="button" role="switch" class="switch-ui use-vault @(on ? "on" : null)" aria-checked="@Aria.Bool(on)"
                            aria-label="Use an Obsidian vault" disabled="@_switching" @onclick="() => UseAsync(!on)"><i></i></button>
                </div>
                @if (on)
                {
                    <div class="setrow">
                        <span class="lbl">Vault folder</span>
                        <div class="input folder @(status.Folder is null ? "unset" : null)">@(status.Folder ?? "Not set")</div>
                        @if (_picker is not null)
                        {
                            <button type="button" class="btn sm choose" disabled="@_choosing" @onclick="ChooseAsync">
                                @(status.Folder is null ? "Choose folder" : "Change")
                            </button>
                        }
                    </div>
                }
                @if (on && _missingChoice is not null)
                {
                    <div class="setrow"><span></span><span class="warn">@_missingChoice isn't there any more. Choose another folder.</span><span></span></div>
                }
                @if (on && status.State != VaultSyncState.NotSetUp)
                {
                    <div class="setrow">
                        <span class="lbl">Last sync</span>
                        @switch (status.State)
                        {
                            case VaultSyncState.Syncing:
                                <span class="sync-state">Syncing…</span>
                                break;
                            case VaultSyncState.Synced when status.LastSyncAt is { } at:
                                <span class="sync-state"><TimeAgo At="at" Capitalized /> · @Notes(status.NoteCount)</span>
                                break;
                            default:
                                <span class="sync-state warn">@Problem(status)</span>
                                break;
                        }
                        <button type="button" class="btn sm rebuild" disabled="@(status.State == VaultSyncState.Syncing)" @onclick="RebuildAsync">Rebuild vault</button>
                    </div>
                }
            </section>
        }
        @if (_digital is not null)
        {
            var movies = _digital.Folder;
            <section class="set" aria-labelledby="digital-heading">
                <h3 id="digital-heading">Digital movies</h3>
                <div class="desc">Shelf looks in one folder for video files and matches them to films by their names.</div>
                <MovieFolder />
                @if (movies.State == MovieFolderState.Ready)
                {
                    <div class="setrow">
                        <span class="lbl">Files</span>
                        <span class="sync-state files-state">@Files(movies)</span>
                        <a class="btn sm review-files" href="import">Review files</a>
                    </div>
                }
            </section>
        }
        @if (Services.GetService<IKeysApi>() is not null)
        {
            <OnlineDatabases />
        }
    </div>
</div>

@code {
    private IVaultApi? _vault;
    private IDigitalApi? _digital;
    private IFolderPicker? _picker;
    private bool _choosing;
    private bool _switching;
    private string? _missingChoice;

    protected override void OnInitialized()
    {
        _vault = Services.GetService<IVaultApi>();
        _picker = Services.GetService<IFolderPicker>();
        if (_vault is not null)
        {
            _vault.StatusChanged += OnChanged;
        }

        _digital = Services.GetService<IDigitalApi>();
        if (_digital is not null)
        {
            _digital.Changed += OnChanged;
        }
    }

    private async Task UseAsync(bool on)
    {
        _switching = true;
        _missingChoice = null;
        try
        {
            await _vault!.SetUseAsync(on);
        }
        finally
        {
            _switching = false;
        }
    }

    private async Task ChooseAsync()
    {
        _choosing = true;
        try
        {
            if (await _picker!.PickFolderAsync() is { } folder)
            {
                _missingChoice = await _vault!.SetFolderAsync(folder) ? null : folder;
            }
        }
        finally
        {
            _choosing = false;
        }
    }

    private Task RebuildAsync() => _vault!.RebuildAsync();

    private static string Notes(int count) =>
        count == 1 ? "1 note" : $"{count.ToString("N0", CultureInfo.InvariantCulture)} notes";

    private static string Problem(VaultStatusDto status) => status.Issue switch
    {
        VaultIssue.FolderMissing => "Folder not found. Reconnect its drive, or choose the folder again.",
        _ => $"Couldn't write to the vault: {status.Detail}",
    };

    // "231 video files · 3 new · 1 missing"
    private static string Files(MovieFolderDto movies) => string.Join(" · ", new[]
    {
        movies.VideoFileCount == 1 ? "1 video file" : $"{Number(movies.VideoFileCount)} video files",
        movies.Files.Count > 0 ? $"{Number(movies.Files.Count)} new" : null,
        movies.Missing.Count > 0 ? $"{Number(movies.Missing.Count)} missing" : null,
    }.OfType<string>());

    private static string Number(int count) => count.ToString("N0", CultureInfo.InvariantCulture);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_digital is not null)
        {
            _digital.Changed -= OnChanged;
        }

        if (_vault is not null)
        {
            _vault.StatusChanged -= OnChanged;
        }
    }
}
