@page "/movies/new"
@page "/movies/{Id:guid}/edit"
@using MMDb.Contracts.Scans
@using MMDb.UI.Movies
@using MMDb.UI.Scanning
@inject ICollectionApi Api
@inject NavigationManager Navigation
@inject ShelfCounts Counts
@inject ScanInbox Queue
@inject ShelfDevice Device

<PageTitle>@(IsNew ? "Add movie" : "Edit movie") · Shelf</PageTitle>

<div class="topbar">
    <a class="btn ghost back" href="@BackHref"><Icon Name="back" />@BackLabel</a>
    @if (_scan is not null)
    {
        <span class="review-count">Review · @(Queue.Items.ToList().IndexOf(_scan) + 1) of @Queue.Items.Count</span>
    }
    <div class="spacer"></div>
    @if (_scan is not null)
    {
        <button type="button" class="btn ghost skip" @onclick="SkipScan">Remove</button>
    }
    @if (_form is not null && _mode == Mode.Edit && !Device.IsPhone)
    {
        @if (IsNew && _gotIt is null)
        {
            <button type="button" class="btn ghost to-wishlist" disabled="@(_form.Title.Trim().Length == 0)" @onclick="() => _mode = Mode.Wish"><Icon Name="heart" />To wishlist</button>
        }
        <a class="btn ghost" href="@BackHref">Cancel</a>
        <button type="button" class="btn primary" disabled="@(!CanSave || _saving)" @onclick="SaveAsync">@SaveLabel</button>
    }
</div>

@if (_loaded && _form is null && !IsNew)
{
    <div class="content">
        <div class="empty">
            <h1>Movie not found</h1>
            <p>It isn't in your collection any more.</p>
            <a class="btn" href="">Back to movies</a>
        </div>
    </div>
}
else if (_loaded && _mode == Mode.Search)
{
    <div class="content">
        <div class="section-head">
            <h1>@(IsNew ? "Add movie" : "Find on TMDB")</h1>
        </div>
        <MovieSearch State="_search" OnPick="Pick" SearchOnOpen="!IsNew">
            <Footer>
                @if (IsNew)
                {
                    <span>Not listed?</span> <button type="button" class="link-btn" @onclick="EnterManually">Enter manually</button>
                    @if (_scan is not null)
                    {
                        <span> · Not a film?</span> <button type="button" class="link-btn as-other" @onclick="() => LookUpAsAsync(ProductKind.Comic)">Look it up as a comic</button>
                    }
                    else if (Device.IsPhone)
                    {
                        <span> · </span><a class="link-btn" href="comics/new">Add a comic instead</a>
                    }
                }
                else
                {
                    <button type="button" class="link-btn" @onclick="() => _mode = Mode.Edit">Back to editing</button>
                }
            </Footer>
        </MovieSearch>
    </div>
}
else if (_form is not null && _mode == Mode.Wish)
{
    <div class="content">
        <div class="section-head">
            <h1>Add to wishlist</h1>
        </div>
        <WantMovie Film="Draft" Owned="_candidate?.Owned?.Formats ?? []" Wanted="Wanted?.Format" Suggested="@(_form.OwnedFormats is [var only] ? only : null)"
                   OnSaved="_ => Wished()" OnCancel="() => _mode = Mode.Edit" />
    </div>
}
else if (_form is not null)
{
    <div class="detail editing">
        <div>
            <Poster Title="@(_form.Title.Trim().Length > 0 ? _form.Title : "Untitled")" Subtitle="@string.Join(" & ", _form.DirectorList)" ImageUrl="PosterImage" />
            @if (!IsNew)
            {
                <button type="button" class="btn sm find" @onclick="FindOnTmdb"><Icon Name="search" />Find on TMDB</button>
            }
        </div>

        <div>
            @if (_problem is not null)
            {
                <div class="problem" role="alert">
                    <span>@_problem</span>
                    @if (_problem == ConflictMessage)
                    {
                        <button type="button" class="btn sm" @onclick="ReloadAsync">Load the latest version</button>
                    }
                    else if (_alreadyOwned is not null)
                    {
                        <a class="btn sm" href="movies/@_alreadyOwned.Id">Open @_alreadyOwned.Title</a>
                    }
                </div>
            }

            @if (_candidate is not null)
            {
                <div class="review-bar">
                    <span class="src">@(_candidateIndex == 0 ? "Best match · TMDB" : "From TMDB")</span>
                    <button type="button" class="link-btn" @onclick="() => _mode = Mode.Search">@NotItLabel</button>
                </div>
            }

            @if (IsNew && Wanted is { } wish)
            {
                <div class="wish-hit">
                    <Icon Name="heart" />
                    <div>
                        <span class="wh"><b>On your wishlist</b> · wanted @Formats.Name(wish.Format)</span>
                        @if (_form.Formats[wish.Format].Owned)
                        {
                            <div class="ts">Saving removes it from your wishlist.</div>
                        }
                        else
                        {
                            <label class="ts keep"><input type="checkbox" @bind="_keepWish" /> Keep it on the wishlist for @Formats.Name(wish.Format)</label>
                        }
                    </div>
                </div>
            }

            @if (IsNew && _candidate?.Owned is { } owned)
            {
                var adding = AddingTo(owned);
                <div class="owned-note">
                    <span class="fmts">
                        @foreach (var format in owned.Formats)
                        {
                            <FormatBadge Format="format" />
                        }
                    </span>
                    <span>
                        You already own this film.
                        @if (adding.Count > 0)
                        {
                            <span>Saving adds <b>@Formats.Join(adding)</b> to it.</span>
                        }
                        else
                        {
                            <span>Switch on a format you don't own yet to add it.</span>
                        }
                    </span>
                </div>
            }

            <div class="eyebrow">@(IsNew ? "New movie" : "Editing")</div>

            <div class="field">
                <label for="title">Title</label>
                <input id="title" class="input title-input @State("Title", _form.Title.Trim() != _baseline?.Title)" @bind="_form.Title" @bind:event="oninput" autocomplete="off" />
                <FieldMessage Errors="_errors" Field="Title" />
            </div>

            <div class="row3">
                <div class="field">
                    <label for="year">Year</label>
                    <input id="year" type="number" class="input @State("Year", _form.Year != _baseline?.Year)" @bind="_form.Year" />
                    <FieldMessage Errors="_errors" Field="Year" />
                </div>
                <div class="field">
                    <label for="runtime">Runtime (min)</label>
                    <input id="runtime" type="number" class="input @State("RuntimeMinutes", _form.RuntimeMinutes != _baseline?.RuntimeMinutes)" @bind="_form.RuntimeMinutes" />
                    <FieldMessage Errors="_errors" Field="RuntimeMinutes" />
                </div>
                <div class="field">
                    <label for="rating">Rating</label>
                    <input id="rating" class="input @State("Rating", Blank(_form.Rating) != _baseline?.Rating)" @bind="_form.Rating" placeholder="e.g. R, PG-13" />
                    <FieldMessage Errors="_errors" Field="Rating" />
                </div>
            </div>

            <div class="field">
                <label for="directors">Directors</label>
                <input id="directors" class="input @State("Directors", !_form.DirectorList.SequenceEqual(_baseline?.Directors ?? []))" @bind="_form.Directors" placeholder="Separate several with commas" />
            </div>

            <div class="field">
                <label for="genre">Genres</label>
                <div class="tags @State("Genres", !_form.Genres.SequenceEqual(_baseline?.Genres ?? []))">
                    @foreach (var genre in _form.Genres)
                    {
                        <span class="tag" @key="genre">@genre<button type="button" aria-label="Remove @genre" @onclick="() => _form.Genres.Remove(genre)"><Icon Name="x" /></button></span>
                    }
                    <input id="genre" class="tag-input" list="genre-options" placeholder="Add genre" autocomplete="off"
                           value="@_newGenre" @oninput="GenreInput" @onkeydown="GenreKeyDown" @onchange="AddTypedGenre" />
                </div>
                <datalist id="genre-options">
                    @foreach (var genre in _genreOptions.Except(_form.Genres, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@genre"></option>
                    }
                </datalist>
            </div>

            <div class="field">
                <label for="overview">Overview</label>
                <textarea id="overview" class="input @State("Overview", Blank(_form.Overview) != _baseline?.Overview)" rows="4" @bind="_form.Overview"></textarea>
            </div>

            <div class="field">
                <label>Cast</label>
                @for (var i = 0; i < ShownCast; i++)
                {
                    var row = _form.Cast[i];
                    <div class="cast-row">
                        <input class="input" placeholder="Name" aria-label="Cast member @(i + 1) name" @bind="row.Name" />
                        <input class="input" placeholder="Role" aria-label="Cast member @(i + 1) role" @bind="row.Character" />
                        <button type="button" class="btn ghost icon" aria-label="Remove cast member @(i + 1)" @onclick="() => _form.Cast.Remove(row)"><Icon Name="x" /></button>
                    </div>
                }
                @if (ShownCast < _form.Cast.Count)
                {
                    <button type="button" class="link-btn show-cast" @onclick="() => _allCast = true">Show all @_form.Cast.Count cast members</button>
                }
                else
                {
                    <button type="button" class="link-btn" @onclick="() => _form.Cast.Add(new CastRow())">+ Add cast member</button>
                }
                <FieldMessage Errors="_errors" Field="Cast" />
            </div>
            @if (_form.Crew.Count > 0)
            {
                <p class="small crew-kept">@_form.Crew.Count crew @(_form.Crew.Count == 1 ? "credit" : "credits") from TMDB @(_form.Crew.Count == 1 ? "is" : "are") kept with this film.</p>
            }
            <FieldMessage Errors="_errors" Field="Crew" />
            <FieldMessage Errors="_errors" Field="PosterPath" />
        </div>

        <div>
            <div class="panel">
                <h3>Formats owned</h3>
                @foreach (var format in Formats.All)
                {
                    var row = _form.Formats[format];
                    var key = format.ToString();
                    <div class="format-row">
                        <button type="button" class="fmt-toggle @(row.Owned ? "on" : "")" aria-pressed="@Aria.Bool(row.Owned)" @onclick="() => Toggle(format)">
                            <FormatBadge Format="format" /><span class="small">@(row.Owned ? "Owned" : "Not owned")</span>
                        </button>
                        @if (row.Owned && Formats.IsDisc(format))
                        {
                            <input class="input mono @State(key + ".Upc", false)" placeholder="UPC (optional)" aria-label="@Formats.Name(format) UPC" @bind="row.Upc" />
                            <FieldMessage Errors="_errors" Field="@(key + ".Upc")" />
                        }
                        else if (row.Owned)
                        {
                            <input class="input mono @State(key + ".FilePath", false)" placeholder="File path (optional)" aria-label="@Formats.Name(format) file path" @bind="row.FilePath" />
                            <FieldMessage Errors="_errors" Field="@(key + ".FilePath")" />
                        }
                    </div>
                }
                <FieldMessage Errors="_errors" Field="Formats" />
            </div>
        </div>
    </div>
}

@if (Device.IsPhone && _loaded && _form is not null && _mode == Mode.Edit)
{
    @* On the phone the save button sits under the thumb, as mocked. *@
    <div class="sticky">
        @if (IsNew && _gotIt is null)
        {
            <button type="button" class="btn to-wishlist" aria-label="Send to wishlist instead" disabled="@(_form.Title.Trim().Length == 0)" @onclick="() => _mode = Mode.Wish"><Icon Name="heart" /></button>
        }
        <button type="button" class="btn primary" disabled="@(!CanSave || _saving)" @onclick="SaveAsync">@SaveLabel</button>
    </div>
}

@code {
    private const string ConflictMessage = "This movie was changed somewhere else after you opened it.";
    private const string DeletedMessage = "This movie was deleted while you were editing it.";

    private enum Mode
    {
        Search,
        Edit,

        /// <summary>Sending the film to the wishlist instead of the collection: choosing the format wanted.</summary>
        Wish,
    }

    private Mode _mode;
    private MovieForm? _form;
    private MovieDto? _original;

    // What the amber "edited" outline compares against: the saved film, or the TMDB match being reviewed.
    private Baseline? _baseline;
    private MovieSearchState _search = new();
    private bool _allCast;

    /// <summary>A full cast runs to a hundred rows or more: the top of the bill is shown until the rest is asked for.</summary>
    private const int CastShownAtFirst = 10;

    private int ShownCast => _allCast ? _form!.Cast.Count : Math.Min(_form!.Cast.Count, CastShownAtFirst);
    private MovieCandidateDto? _candidate;
    private int _candidateIndex;

    private bool _loaded;
    private bool _saving;
    private string? _problem;
    private MovieDto? _alreadyOwned;
    private string? _newGenre;
    private IReadOnlyList<string> _genreOptions = [];
    private Dictionary<string, string> _errors = [];

    // The scan being reviewed (phone): the editor opens on what the PC found for it.
    private ScanItem? _scan;
    private Guid? _openedScan;

    // The wishlist item being bought ("Got it"): the editor opens on its TMDB entry with the wanted format switched on.
    private MovieWishDto? _gotIt;
    private Guid? _openedWish;
    private bool _keepWish = true;

    [Parameter] public Guid? Id { get; set; }

    /// <summary>A scan from the phone's queue to review.</summary>
    [SupplyParameterFromQuery(Name = "scan")] public Guid? Scan { get; set; }

    /// <summary>A film on the wishlist that has been bought.</summary>
    [SupplyParameterFromQuery(Name = "wish")] public Guid? Wish { get; set; }

    private bool IsNew => Id is null;

    private string BackHref => _scan is not null ? "scan" : _gotIt is not null ? "wishlist" : IsNew ? "" : $"movies/{Id}";

    private string BackLabel => _scan is not null ? "Scan" : _gotIt is not null ? "Wishlist" : IsNew || _original is null ? "Movies" : _original.Title;

    /// <summary>The wishlist item for the film on screen: the one the match picked is on, or without a match the one being bought.</summary>
    private MovieWishDto? Wanted => _candidate is not null ? _candidate.Wish : _gotIt;

    private WishDraft Draft => new(_form!.Title.Trim(), _form.Year, _form.DirectorList, _form.TmdbId, _form.TrailerYouTubeKey, _form.PosterPath, PosterImage);

    private bool CanSave => _form!.CanSave && !(IsNew && _candidate?.Owned is { } owned && AddingTo(owned).Count == 0);

    private string SaveLabel => !IsNew ? "Save changes"
        : _candidate?.Owned is { } owned && AddingTo(owned) is { Count: > 0 } adding
            ? $"Add {Formats.Join(adding)} format{(adding.Count == 1 ? "" : "s")}"
            : "Add movie";

    private string NotItLabel => (_search.Response?.Candidates.Count ?? 1) - 1 is var others and > 0
        ? $"Not it? {others} other match{(others == 1 ? "" : "es")}"
        : "Not it? Search again";

    private Uri? PosterImage =>
        _form?.PosterPath is not { } poster ? null
        : _candidate?.PosterPath == poster ? _candidate.PosterUrl
        : _original?.PosterPath == poster ? _original.CoverUrl
        : null;

    protected override async Task OnParametersSetAsync()
    {
        _genreOptions = (await Api.ListMoviesAsync(new())).Facets.Genres;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _problem = null;
        _alreadyOwned = null;
        _errors = [];
        if (IsNew)
        {
            _mode = Mode.Search;
            if (!_loaded || Scan != _openedScan || Wish != _openedWish)
            {
                OpenScan();
                await OpenWishAsync();
            }
        }
        else
        {
            _original = await Api.GetMovieAsync(Id!.Value);
            _form = _original is null ? null : MovieForm.From(_original);
            _baseline = _original is null ? null : Baseline.From(_original);
            _candidate = null;
            _mode = Mode.Edit;
        }

        _loaded = true;
    }

    // Starts from what the PC found for the scan: the best match filled in, or the search step saying why not.
    private void OpenScan()
    {
        _openedScan = Scan;
        _scan = Queue.Find(Scan) is { State: ScanState.Ready, Response.Movie: not null } item ? item : null;
        _form = null;
        _candidate = null;
        _baseline = null;
        _search = new();
        if (_scan?.Response?.Movie is { } found)
        {
            _search.Answer(_scan.Code, found);
            if (found is { Status: LookupStatus.Found, Candidates: [var best, ..] })
            {
                Pick(best);
            }
        }
    }

    private async Task OpenWishAsync()
    {
        _openedWish = Wish;
        _gotIt = null;
        _keepWish = true;
        if (Wish is not { } id || await Api.LookupWishlistMovieAsync(id) is not { } found)
        {
            return;
        }

        _gotIt = found.Wish;
        _search.Query = $"{found.Wish?.Title} {found.Wish?.Year}".Trim();
        _search.Answer(_search.Query, found);
        if (found is { Status: LookupStatus.Found, Candidates: [var best, ..] })
        {
            Pick(best);
        }
    }

    private void SkipScan()
    {
        Queue.Remove(_scan!.Id);
        Navigation.NavigateTo(Queue.Items.Count > 0 ? "scan/review" : "scan", replace: true);
    }

    // A comic whose add-on the camera didn't read looks like a film.
    private async Task LookUpAsAsync(ProductKind kind)
    {
        var item = _scan!;
        await Queue.RetryAsync(item, kind);
        Navigation.NavigateTo($"scan/review?item={item.Id}", replace: true);
    }

    private void Pick(MovieCandidateDto candidate)
    {
        _candidate = candidate;
        _candidateIndex = _search.Response?.Candidates.ToList().IndexOf(candidate) ?? 0;
        if (IsNew)
        {
            // Picking another match after a first one keeps the formats already switched on.
            var previous = _form;
            _form = MovieForm.From(candidate);
            if (previous is null)
            {
                UseScannedBarcode();
                UseWantedFormat();
            }
            else
            {
                foreach (var (format, row) in previous.Formats)
                {
                    _form.Formats[format] = row;
                }
            }

            _baseline = Baseline.From(candidate);
        }
        else
        {
            // Edit: the outline keeps comparing with the saved film, so it shows what TMDB changes.
            _form!.Apply(candidate);
        }

        _errors = [];
        _problem = null;
        _mode = Mode.Edit;
    }

    private void EnterManually()
    {
        _form ??= new MovieForm();
        if (_gotIt is { } wish && _form.Title.Length == 0)
        {
            (_form.Title, _form.Year) = (wish.Title, wish.Year);
            UseWantedFormat();
        }
        else if (_search.SearchedFor is { } typed && _search.Response?.Upc is null && _form.Title.Length == 0)
        {
            _form.Title = typed;
        }

        UseScannedBarcode();
        _candidate = null;
        _baseline = null;
        _mode = Mode.Edit;
    }

    // The UPC goes on the format its product names. Without a format there is no telling which disc it is for.
    private void UseScannedBarcode()
    {
        if (_search.Barcode is var (upc, format))
        {
            _form!.Formats[format] = new FormatRow { Owned = true, Upc = Formats.IsDisc(format) ? upc : null };
        }
    }

    // "Got it": what was wanted is what was bought, unless the user says otherwise.
    private void UseWantedFormat()
    {
        if (_gotIt is { } wish)
        {
            _form!.Formats[wish.Format].Owned = true;
        }
    }

    // The film went on the wishlist instead of into the collection.
    private void Wished()
    {
        if (_scan is not null)
        {
            Queue.Remove(_scan.Id);
            Navigation.NavigateTo(Queue.Items.Count > 0 ? "scan/review" : "wishlist", replace: true);
            return;
        }

        Navigation.NavigateTo("wishlist", replace: true);
    }

    private void Toggle(MovieFormatKind format)
    {
        var row = _form!.Formats[format];
        row.Owned = !row.Owned;
    }

    private void FindOnTmdb()
    {
        _search.Query = $"{_form!.Title.Trim()} {_form.Year}".Trim();
        _search.Response = null;
        _mode = Mode.Search;
    }

    private List<MovieFormatKind> AddingTo(MovieSummaryDto owned) => [.. _form!.OwnedFormats.Except(owned.Formats)];

    private async Task SaveAsync()
    {
        AddTypedGenre();
        _saving = true;
        _problem = null;
        _alreadyOwned = null;
        try
        {
            var request = _form!.ToRequest();
            var response = IsNew
                ? await Api.AddMovieAsync(request)
                : await Api.UpdateMovieAsync(Id!.Value, _original!.Version, request);

            switch (response.Status)
            {
                case SaveStatus.Saved:
                    // Bought on another format than the one wanted, and asked not to keep wanting it.
                    if (IsNew && !_keepWish && Wanted is { } wish && !_form.Formats[wish.Format].Owned)
                    {
                        await Api.RemoveWishlistMovieAsync(wish.Id);
                    }

                    if (_scan is not null)
                    {
                        // On to the next scan; after the last one, the library shows what was added.
                        Queue.Remove(_scan.Id);
                        Navigation.NavigateTo(Queue.Items.Count > 0 ? "scan/review" : "", replace: true);
                        return;
                    }

                    await Counts.RefreshAsync();
                    Navigation.NavigateTo($"movies/{response.Movie!.Id}", replace: IsNew);
                    return;
                case SaveStatus.Invalid:
                    _errors = response.Errors.GroupBy(e => e.Field).ToDictionary(g => g.Key, g => string.Join(" ", g.Select(e => e.Message)));
                    break;
                case SaveStatus.Conflict:
                    _problem = ConflictMessage;
                    break;
                case SaveStatus.NotFound:
                    _problem = DeletedMessage;
                    break;
                case SaveStatus.AlreadyOwned:
                    _alreadyOwned = response.Movie;
                    _problem = $"You already own {response.Movie!.Title} on {Formats.Join([.. response.Movie.Formats.Select(f => f.Format)])}.";
                    break;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    // A comma finishes a genre, so "Crime, Drama" can be typed or pasted in one go.
    private void GenreInput(ChangeEventArgs e)
    {
        var parts = (e.Value?.ToString() ?? "").Split(',');
        foreach (var finished in parts[..^1])
        {
            _form!.AddGenre(finished);
        }

        _newGenre = parts[^1];
    }

    private void GenreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTypedGenre();
        }
    }

    private void AddTypedGenre()
    {
        foreach (var genre in (_newGenre ?? "").Split(','))
        {
            _form!.AddGenre(genre);
        }

        _newGenre = null;
    }

    // "edited" (amber outline) marks a change from the baseline; "invalid" marks a rejected field.
    private string State(string field, bool changed) =>
        _errors.ContainsKey(field) ? "invalid" : _baseline is not null && changed ? "edited" : "";

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed record Baseline(
        string Title, int? Year, int? RuntimeMinutes, string? Rating, IReadOnlyList<string> Directors, IReadOnlyList<string> Genres, string? Overview)
    {
        public static Baseline From(MovieDto movie) =>
            new(movie.Title, movie.Year, movie.RuntimeMinutes, Blank(movie.Rating), movie.Directors, movie.Genres, Blank(movie.Overview));

        public static Baseline From(MovieCandidateDto candidate) =>
            new(candidate.Title, candidate.Year, candidate.RuntimeMinutes, Blank(candidate.Rating), candidate.Directors, candidate.Genres, Blank(candidate.Overview));
    }
}
