@inject ShelfDevice Device

@* The cover if there is one; otherwise (and while it loads) a gradient placeholder picked from the title. *@
<div class="poster @Class @(ImageUrl is null ? "" : "has-image")" style="@PosterColors.Style(Title)">
    <span class="pt">@Title</span>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <span class="pd">@Subtitle</span>
    }
    @if (ImageUrl is not null)
    {
        @* A broken image hides itself so the placeholder shows through. *@
        @* Decoded with the page, not after it: an image decoded "async" is left out of the picture until its turn
           comes, and with a screenful of covers the WebView's budget for those runs out, so some never appear. *@
        <img src="@(Large && Device.IsPhone ? ImageUrl.AbsoluteUri + "?full=1" : ImageUrl.AbsoluteUri)" alt="" loading="lazy" decoding="sync" onerror="this.style.display='none'" />
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Small caps line under the title, usually the director.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>The cover image; the placeholder shows if this is null or fails to load.</summary>
    [Parameter] public Uri? ImageUrl { get; set; }

    /// <summary>
    /// The page shows this one cover large. The phone keeps smaller copies of its covers, so there it asks for
    /// the PC's own file (and gets it while the PC is in reach).
    /// </summary>
    [Parameter] public bool Large { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
