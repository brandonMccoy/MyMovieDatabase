@inherits LayoutComponentBase
@implements IDisposable
@inject ShelfCounts Counts
@inject IServiceProvider Services

<IconSprite />
<div class="window">
    <aside class="side">
        <div class="brand"><div class="brand-mark"><Icon Name="film" Class="i14" /></div><span class="brand-name">Shelf</span></div>
        <div>
            <div class="nav-label">Collection</div>
            <nav class="nav">
                <MoviesNavLink href="" Match="NavLinkMatch.Prefix">
                    <Icon Name="film" />Movies<span class="count">@Counts.Movies?.ToString("N0", CultureInfo.InvariantCulture)</span>
                </MoviesNavLink>
                <NavLink href="comics" Match="NavLinkMatch.Prefix">
                    <Icon Name="book" />Comics<span class="count">@Counts.Comics?.ToString("N0", CultureInfo.InvariantCulture)</span>
                </NavLink>
            </nav>
        </div>
        <div class="side-foot">
            @if (_vault is not null)
            {
                var status = _vault.Status;
                <div class="vault-line @(status.State == VaultSyncState.Failed ? "warn" : null)">
                    <Icon Name="obsidian" Class="i12 obsidian" />
                    @switch (status.State)
                    {
                        case VaultSyncState.NotSetUp:
                            <span>Vault not set up</span>
                            break;
                        case VaultSyncState.Syncing:
                            <span>Vault syncing…</span>
                            break;
                        case VaultSyncState.Synced when status.LastSyncAt is { } at:
                            <span>Vault synced · <TimeAgo At="at" /></span>
                            break;
                        default:
                            <span>Vault not updated</span>
                            break;
                    }
                </div>
            }
            <nav class="nav">
                <NavLink href="settings"><Icon Name="gear" />Settings</NavLink>
            </nav>
        </div>
    </aside>
    <div class="main">
        @Body
    </div>
</div>

@code {
    private IVaultApi? _vault;

    protected override async Task OnInitializedAsync()
    {
        _vault = Services.GetService<IVaultApi>();
        if (_vault is not null)
        {
            _vault.StatusChanged += OnChanged;
        }

        Counts.Changed += OnChanged;
        await Counts.RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Counts.Changed -= OnChanged;
        if (_vault is not null)
        {
            _vault.StatusChanged -= OnChanged;
        }
    }
}
