@inherits LayoutComponentBase
@implements IDisposable
@inject ShelfCounts Counts
@inject ITypesApi Types
@inject IServiceProvider Services

<IconSprite />
<div class="window">
    <aside class="side">
        <div class="brand"><div class="brand-mark"><Icon Name="film" Class="i14" /></div><span class="brand-name">Shelf</span></div>
        <div>
            <div class="nav-label">Collection</div>
            <nav class="nav">
                @if (Types.InUse.Movies)
                {
                    <MoviesNavLink href="" Match="NavLinkMatch.Prefix">
                        <Icon Name="film" />Movies<span class="count">@Counts.Movies?.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </MoviesNavLink>
                }
                @if (Types.InUse.Comics)
                {
                    <NavLink href="comics" Match="NavLinkMatch.Prefix">
                        <Icon Name="book" />Comics<span class="count">@Counts.Comics?.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </NavLink>
                }
                <NavLink href="wishlist" Match="NavLinkMatch.Prefix">
                    <Icon Name="heart" />Wishlist<span class="count">@Counts.Wishlist?.ToString("N0", CultureInfo.InvariantCulture)</span>
                </NavLink>
                @if (Services.GetService<IStatsApi>() is not null)
                {
                    <NavLink href="stats"><Icon Name="chart" />Stats</NavLink>
                }
            </nav>
        </div>
        <div class="side-foot">
            @if (_vault?.Status is { State: not VaultSyncState.Off } status)
            {
                <div class="vault-line @(status.State == VaultSyncState.Failed ? "warn" : null)">
                    <Icon Name="obsidian" Class="i12 obsidian" />
                    @switch (status.State)
                    {
                        case VaultSyncState.NotSetUp:
                            <span>Vault not set up</span>
                            break;
                        case VaultSyncState.Syncing:
                            <span>Vault syncing…</span>
                            break;
                        case VaultSyncState.Synced when status.LastSyncAt is { } at:
                            <span>Vault synced · <TimeAgo At="at" /></span>
                            break;
                        default:
                            <span>Vault not updated</span>
                            break;
                    }
                </div>
            }
            @if (Types.InUse.Movies && _digital?.Folder.Files.Count is > 0 and var waiting)
            {
                <a class="vault-line new-files" href="import">
                    <Icon Name="film" Class="i12" />
                    <span>@(waiting == 1 ? "1 new file" : $"{waiting.ToString("N0", CultureInfo.InvariantCulture)} new files")</span>
                </a>
            }
            <nav class="nav">
                <NavLink href="settings"><Icon Name="gear" />Settings</NavLink>
            </nav>
        </div>
    </aside>
    <div class="main">
        @Body
    </div>
</div>

@code {
    private IVaultApi? _vault;
    private IDigitalApi? _digital;

    protected override async Task OnInitializedAsync()
    {
        _digital = Services.GetService<IDigitalApi>();
        if (_digital is not null)
        {
            _digital.Changed += OnChanged;
        }

        _vault = Services.GetService<IVaultApi>();
        if (_vault is not null)
        {
            _vault.StatusChanged += OnChanged;
        }

        Types.Changed += OnChanged;
        Counts.Changed += OnChanged;
        await Counts.RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Types.Changed -= OnChanged;
        Counts.Changed -= OnChanged;
        if (_digital is not null)
        {
            _digital.Changed -= OnChanged;
        }
        if (_vault is not null)
        {
            _vault.StatusChanged -= OnChanged;
        }
    }
}
