@inherits LayoutComponentBase
@implements IDisposable
@using MMDb.Contracts.Phone
@using MMDb.UI.Phone
@inject IPcLink Link
@inject IPhoneSync Sync
@inject NavigationManager Navigation

@* The phone's frame: pairing first, then its copy of the collection once (the only time the PC has to be there),
   then the screens with the bottom bar, which show that copy wherever the phone is. *@
<IconSprite />
<div class="phone-app @(Path == "scan" ? "see-through" : null)">
    @if (!_started)
    {
        @* The pairing kept on the phone is read in a blink; nothing to show yet. *@
    }
    else if (Link.State is PcLinkState.NotPaired or PcLinkState.Unpaired)
    {
        <PairScreen />
    }
    else if (Sync.Status.SyncedAt is null && Path != "phone")
    {
        @* Nothing to show yet. *@
        @if (Sync.Status.State == PhoneSyncState.WrongVersion)
        {
            <div class="phone-notice" role="alert">
                <div class="brand"><div class="brand-mark"><Icon Name="film" Class="i14" /></div><span class="brand-name">Shelf</span></div>
                <h1>Update Shelf</h1>
                <p>Shelf on this phone and on @(Link.PcName ?? "your PC") are different versions. Update both, then try again.</p>
                <button type="button" class="btn primary" @onclick="RetryAsync">Try again</button>
            </div>
        }
        else if (Link.State == PcLinkState.Unreachable)
        {
            <PcAway OnRetry="RetryAsync" />
        }
        else
        {
            <div class="phone-notice" role="status">
                <div class="brand"><div class="brand-mark"><Icon Name="film" Class="i14" /></div><span class="brand-name">Shelf</span></div>
                <h1>Copying your collection</h1>
                <p>From @(Link.PcName ?? "your PC"), so this phone has it wherever you are. Covers follow in the background.</p>
            </div>
        }
    }
    else
    {
        <div class="phone-body">
            <ErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="error">
                    <div class="phone-notice" role="alert">
                        <h1>Something went wrong</h1>
                        <p>Shelf couldn't show this screen.</p>
                        <button type="button" class="btn" @onclick="Recover">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
        @if (ShowsNav)
        {
            <nav class="bnav" aria-label="Sections">
                <NavLink href="" class="@(IsMovies ? "on" : null)" ActiveClass=""><Icon Name="film" /><span>Movies</span></NavLink>
                <NavLink href="comics" class="@(IsComics ? "on" : null)" ActiveClass=""><Icon Name="book" /><span>Comics</span></NavLink>
                <a href="scan" class="scan" aria-label="Scan"><span class="scanbtn"><Icon Name="scan" /></span></a>
                <NavLink href="wishlist" class="@(IsWishlist ? "on" : null)" ActiveClass=""><Icon Name="heart" /><span>Wishlist</span></NavLink>
                <NavLink href="stats" class="@(Path == "stats" ? "on" : null)" ActiveClass=""><Icon Name="chart" /><span>Stats</span></NavLink>
            </nav>
        }
    }
</div>

@code {
    private ErrorBoundary? _boundary;
    private bool _started;
    private bool _fetching;

    private string Path => new Uri(Navigation.Uri).AbsolutePath.Trim('/');

    private bool IsComics => Path == "comics" || Path.StartsWith("comics/", StringComparison.Ordinal);

    private bool IsWishlist => Path == "wishlist" || Path.StartsWith("wishlist/", StringComparison.Ordinal);

    private bool IsMovies => Path.Length == 0 || Path == "movies" || Path.StartsWith("movies/", StringComparison.Ordinal);

    // Scanning and reviewing fill the screen, as mocked.
    private bool ShowsNav => Path != "scan" && !Path.StartsWith("scan/", StringComparison.Ordinal) && !Path.EndsWith("/new", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Link.Changed += OnChanged;
        Sync.Changed += OnSyncChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Link.StartAsync();
        _started = true;

        // The screens show the phone's copy meanwhile; a PC that is off can take seconds to not answer.
        StateHasChanged();
        await Sync.SyncAsync();
    }

    private async Task RetryAsync()
    {
        await Sync.SyncAsync();
        Recover();
    }

    private void Recover() => _boundary?.Recover();

    private void OnChanged() => InvokeAsync(() =>
    {
        // Just paired: fetch the collection.
        if (Link.State == PcLinkState.Connected && Sync.Status is { SyncedAt: null, State: PhoneSyncState.Idle } && !_fetching)
        {
            _fetching = true;
            _ = FetchAsync();
        }

        StateHasChanged();
    });

    private async Task FetchAsync()
    {
        try
        {
            await Sync.SyncAsync();
        }
        finally
        {
            _fetching = false;
        }
    }

    private void OnSyncChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        Recover();
        StateHasChanged();
    });

    public void Dispose()
    {
        Link.Changed -= OnChanged;
        Sync.Changed -= OnSyncChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
