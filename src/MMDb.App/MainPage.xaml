<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:MMDb.UI;assembly=MMDb.UI"
             x:Class="MMDb.App.MainPage"
             BackgroundColor="#0e1115">

    <!-- On the phone the camera view is added under the web view (see MainPage.xaml.cs). -->
    <Grid x:Name="root">
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
